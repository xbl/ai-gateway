# LiteLLM Proxy 环境变量模板
# 复制为 .env 并填入真实密钥: cp .env.example .env

# === LiteLLM 自身 ===
# 用于访问 /chat/completions 等接口的 Bearer Token（在 UI 中也用作登录）
LITELLM_MASTER_KEY=sk-litellm-master-key-change-me

# 用于存储 spend logs / model info（Postgres）
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm

# === 各模型 Provider API Keys ===
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GAOGEAII_API_KEY=sk-your-gaogeaii-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
GEMINI_API_KEY=your-gemini-key
MINIMAX_API_KEY=your-minimax-key
ZHIPU_API_KEY=your-zhipu-key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# === 端口（可选，默认 4000） ===
LITELLM_PORT=4000
# AgentRouter (https://agentrouter.org/v1)
AGENTROUTER_API_KEY=sk-your-agentrouter-key

# JustWoker (https://api.justwoker.icu) - 仅支持 claude-opus-4-8
JUSTWOKER_API_KEY=sk-your-justwoker-key
